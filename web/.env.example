# Matrícula+ (app web). Copie para .env.local e preencha. Nunca versionar valores reais.
# Em desenvolvimento, `npm run dev` na raiz gera web/.env.local apontando para o Supabase local.

# ---------------------------------------------------------------
# Supabase (Auth, Postgres, Storage)
# ---------------------------------------------------------------
# Conexão Postgres usada pelo Prisma (schema "curricular"). Produção: pooler da Supabase.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:56422/postgres"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:56421"
# Chave publishable: pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Chave secreta (sb_secret_...): somente servidor. Nunca NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# ---------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------
APP_URL="http://localhost:3010"
# 32 bytes em base64 (openssl rand -base64 32): cifra as chaves OpenAI das empresas.
APP_ENCRYPTION_KEY=""
APP_ENCRYPTION_KEY_VERSION="1"
# Rotinas agendadas: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
# Armazenamento dos PDFs: supabase (bucket privado) ou local (pasta STORAGE_DIR).
STORAGE_DRIVER="supabase"
SUPABASE_STORAGE_BUCKET="documents"
# Fuso usado para exibir datas (padrão: Brasília).
# NEXT_PUBLIC_APP_TIME_ZONE="America/Sao_Paulo"

# ---------------------------------------------------------------
# Marca da plataforma (revenda)
# ---------------------------------------------------------------
# NEXT_PUBLIC_BRAND_NAME="Matrícula+"
# NEXT_PUBLIC_BRAND_LOGO="/brand/logo.svg"     # arquivo em web/public/brand/
# NEXT_PUBLIC_SUPPORT_EMAIL="suporte@suaempresa.com.br"

# ---------------------------------------------------------------
# IA: chave da plataforma (opcional). Empresas sem chave própria usam esta e consomem créditos do plano.
# ---------------------------------------------------------------
# OPENAI_PLATFORM_API_KEY=""

# ---------------------------------------------------------------
# Cobrança Efí (API de Cobranças). Sem estas variáveis, só o teste grátis e a liberação manual funcionam.
# ---------------------------------------------------------------
# EFI_CLIENT_ID=""
# EFI_CLIENT_SECRET=""
# EFI_SANDBOX="true"                          # "false" em produção
# EFI_WEBHOOK_SECRET=""                       # texto aleatório longo; vai na URL de notificação
# NEXT_PUBLIC_EFI_ACCOUNT_ID=""               # Identificador de conta (pagamento com cartão)

# ---------------------------------------------------------------
# E-mail transacional do sistema (opcional). Os e-mails de login/senha são enviados pelo Supabase Auth.
# ---------------------------------------------------------------
# EMAIL_USER=""
# EMAIL_APP_PASSWORD=""
# EMAIL_FROM="Matrícula+ <no-reply@suaempresa.com.br>"
# EMAIL_SMTP_HOST="smtp.gmail.com"
# EMAIL_SMTP_PORT="465"

# ---------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------
# VAPID_PUBLIC_KEY=""                         # notificações no navegador
# VAPID_PRIVATE_KEY=""
# NEXT_PUBLIC_SENTRY_DSN=""
# ANDROID_APP_PACKAGE="br.com.suaempresa.app"
# ANDROID_APP_SHA256=""
