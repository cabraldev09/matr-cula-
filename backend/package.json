  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "nodemon dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only --ignore node_modules src/server.ts",
    "test": "node -e \"console.error('Run npm test at the repository root for the isolated security suite.'); process.exit(1)\"",
    "db:migrate": "npm run build && sequelize db:migrate",
    "db:seed": "sequelize db:seed:all",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:legacy": "node scripts/guard-test-db.cjs && NODE_ENV=test sequelize db:migrate && NODE_ENV=test sequelize db:seed:all && NODE_ENV=test jest"
  },
