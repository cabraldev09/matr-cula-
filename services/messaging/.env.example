# Server only. Never copy these variables to frontend/.env.
# Direct Postgres connection; local dev generates .local/messaging.env automatically.
MESSAGING_DATABASE_URL=
MESSAGING_PORT=8081
MESSAGING_HOST=127.0.0.1
META_APP_SECRET=
META_VERIFY_TOKEN=
# Select a Graph API version supported by your Meta app.
META_GRAPH_VERSION=
# Map each SaaS channel UUID to its own access token, all on one line.
WHATSAPP_CHANNEL_TOKENS={}
